# The Spire dedicated floor server, one systemd instance per floor server.
#
# Install (as root, see docs/DEDICATED_SERVER.md):
#   useradd --system --home /var/lib/the-spire --shell /usr/sbin/nologin spire
#   mkdir -p /opt/the-spire /var/lib/the-spire && chown spire:spire /var/lib/the-spire
#   cp build/linux-server/* tools/server/run_server.sh /opt/the-spire/ && chmod +x /opt/the-spire/*
#   cp tools/server/the-spire-server@.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now the-spire-server@floor1
#
# The instance name picks /etc/the-spire/<instance>.env (optional), e.g.
# /etc/the-spire/floor1.env:
#   SPIRE_PORT=4433
#   SPIRE_FLOOR=1
#   SPIRE_NAME=Town of First Light
#   SPIRE_CAPACITY=30
# A second floor-1 instance needs its own port: floor1b.env with SPIRE_PORT=4434.
#
# Logs: journalctl -u the-spire-server@floor1 -f   (also logs/godot.log in the data dir)

[Unit]
Description=The Spire dedicated floor server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spire
Group=spire
Environment=SPIRE_BIN=/opt/the-spire/the-spire-server.x86_64
# Each instance keeps its own records and realm DB: two processes must never
# share one data dir (docs/REALM_DB.md: no multi-process journal yet).
Environment=SPIRE_DATA=/var/lib/the-spire/%i
EnvironmentFile=-/etc/the-spire/%i.env
ExecStart=/opt/the-spire/run_server.sh
# Auto-restart on a crash or exit, with a short back-off; give up only if it
# crash-loops 10 times in 5 minutes (then check the journal).
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
# Room to flush records on stop.
TimeoutStopSec=20
KillSignal=SIGINT
# Hardening: the server only writes its data dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/the-spire
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
