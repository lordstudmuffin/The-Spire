; Engine configuration file.
; Godot 4.3+
;
; The [input] section mirrors autoload/input_setup.gd (InputSetup.DEFAULTS),
; which is the source of truth at runtime: it re-registers every action with
; keyboard/mouse + gamepad defaults and the player's remaps from
; user://settings.json. Regenerate with scratchpad gen_input.gd if DEFAULTS change.

config_version=5

[application]

config/name="Anime Life RPG"
config/description="Open-world create-your-character anime RPG (vertical slice)."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

InputSetup="*res://autoload/input_setup.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
Net="*res://autoload/net.gd"
Settings="*res://autoload/settings.gd"
Audio="*res://autoload/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/vrm/plugin.cfg")

