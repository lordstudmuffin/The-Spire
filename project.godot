[physics]

common/physics_ticks_per_second=60

[rendering]

limits/opengl/max_renderable_elements=262144
limits/opengl/max_renderable_lights=64
limits/opengl/max_lights_per_object=16

textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_quality=5
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_quality=5
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=3
global_illumination/sdfgi/frames_to_update_lights=1
environment/ssao/quality=3
environment/ssil/quality=3
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/subsurface_scattering/subsurface_scattering_quality=2
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=0
scaling_3d/scale=1.0
scaling_3d/fsr_sharpness=0.2
mesh_lod/lod_change/threshold_pixels=2.0
